# Copy to .env.local and fill in. .env.local is gitignored.
# No spaces around "=" — this file is sourced by shell scripts as well as read
# by Next, and `KEY= value` makes the shell try to run `value`.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for corpus ingestion, which must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Migrations only, never read by the app. Use the SESSION-MODE POOLER host
# (aws-N-<region>.pooler.supabase.com:5432, user postgres.<project-ref>).
# The direct host the dashboard shows is IPv6-only and will not resolve on an
# IPv4-only network.
SUPABASE_DB_URL=

# ─── Quran.com content API (Quran Foundation) ───────────────────────────────
# https://api-docs.quran.foundation/request-access/
# OAuth2 client_credentials, scope "content". Note pre-live carries only 2 of
# the 114 surahs, so production is used in development too.
QURAN_OAUTH_URL=https://oauth2.quran.foundation/oauth2/token
QURAN_API_BASE=https://apis.quran.foundation
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

QURAN_PRELIVE_OAUTH_URL=https://prelive-oauth2.quran.foundation/oauth2/token
QURAN_PRELIVE_API_BASE=https://apis-prelive.quran.foundation
QURAN_PRELIVE_CLIENT_ID=
QURAN_PRELIVE_CLIENT_SECRET=

# ─── AI (phase 4) ───────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://www.voyageai.com — embeddings; Anthropic has no embeddings endpoint.
VOYAGE_API_KEY=

# ─── Money (phases 5 and 7) ─────────────────────────────────────────────────
METALS_API_KEY=
METALS_PROVIDER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email (Supabase Auth SMTP) ─────────────────────────────────────────────
# Resend, sending as noreply@sahn-ai.com. The DNS records live on the `send`
# subdomain in Cloudflare; the address itself is not a real mailbox and does
# not need to be — Resend sends on behalf of the domain.
RESEND_API_KEY=

# ─── Alerts ─────────────────────────────────────────────────────────────────
# Where server errors are emailed, on the first occurrence of each fault and
# then at most hourly. Leave unset to record errors without emailing. Delivery
# uses RESEND_API_KEY above, sending from noreply@sahn-ai.com.
ALERT_EMAIL=

# ─── App ────────────────────────────────────────────────────────────────────
# Production: https://sahn-ai.com — must also be listed in Supabase under
# Authentication → URL Configuration, or auth links bounce.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
